# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/royalgad"

# NextAuth.js (v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Site URL (used for Paystack callback)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxx"

# SMTP (Email via Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="info@royalgad.com.ng"
ADMIN_EMAIL="info@royalgad.com.ng"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_RECIPIENT="+2348023282550"

# Cloudinary (optional - for image optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Analytics
NEXT_PUBLIC_GA_ID=""
